{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "stream",
  "tasks": {
    "build": { "dependsOn": ["^build"], "outputs": ["dist/**"] },
    "codegen": { "dependsOn": ["^build"], "cache": false },
    "dev": { "cache": false, "persistent": true, "passThroughEnv": ["S3_PUBLIC_ENDPOINT"] },
    "typecheck": { "dependsOn": ["^build", "codegen"] },
    "test": { "dependsOn": ["^build"], "env": ["TEST_*"], "passThroughEnv": ["CHROMIUM_PATH", "LD_LIBRARY_PATH", "FONTCONFIG_FILE", "SCREENSHOTS"] }
  }
}
