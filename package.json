{
  "name": "archlast-forge",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "codegen": "turbo run codegen",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "services:up": "docker compose up -d --wait postgres redis rustfs && docker compose up rustfs-init",
    "test:all": "TEST_POSTGRES_URL=postgres://forge:forge@localhost:55432/forge TEST_REDIS_URL=redis://localhost:56379 TEST_S3_ENDPOINT=http://localhost:59000 turbo run test"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "turbo": "^2.11.10",
    "typescript": "7.0.2"
  },
  "engines": {
    "bun": ">=1.4.3"
  },
  "packageManager": "bun@1.4.3",
  "workspaces": [
    "apps/*",
    "apps/*/convex",
    "packages/*"
  ]
}
