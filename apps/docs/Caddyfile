# Plain HTTP on :80. Put a proxy in front for HTTPS, or replace :80 with your domain and Caddy gets a certificate by itself.
:80 {
	root * /srv
	encode zstd gzip

	# Hashed files never change, and a missing one is a real 404 (the app then offers a reload).
	@chunks path /chunk-*
	handle @chunks {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Everything else is a page of the single-page app.
	handle {
		try_files {path} /index.html
		file_server
	}
}
