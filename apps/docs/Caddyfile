# Plain HTTP on :80. Put a proxy in front for HTTPS, or replace :80 with your domain and Caddy gets a certificate by itself.
:80 {
	root * /srv
	encode zstd gzip

	# Hashed files never change, and a missing one is a real 404 (the app then offers a reload).
	@chunks path /chunk-*
	handle @chunks {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# A page is a folder with an index.html (the text is in it for readers without JavaScript; the app takes over in a browser).
	# Anything else that is missing is a real 404, shown as the app's "Page not found".
	handle {
		try_files {path} {path}/index.html
		file_server
	}
	handle_errors {
		rewrite * /404.html
		file_server
	}
}
