# Copy to .env (Bun loads it). Everything is optional in dev.
# DATABASE_URL=postgres://forge:forge@localhost:55432/forge   # default: bun:sqlite in ./data
# REDIS_URL=redis://localhost:56379                           # default: in-memory bus and cache
# File attachments, using RustFS from the root docker-compose.yml:
S3_ENDPOINT=http://localhost:59000
S3_BUCKET=forge
S3_ACCESS_KEY_ID=forgeadmin
S3_SECRET_ACCESS_KEY=forgeadmin
S3_REGION=us-east-1
# REMINDER_WEBHOOK_URL=https://example.com/hook               # sendReminder POSTs here; logs otherwise
