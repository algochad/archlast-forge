# The same NestJS app (its Express adapter) on Bun with the store in SQLite (bun:sqlite) (build context: benchmarks/rest).
FROM oven/bun:1.4.4-alpine
WORKDIR /app
COPY servers/nest/package.json .
RUN bun install --production
COPY servers/nest/*.ts servers/nest/tsconfig.json ./
COPY servers/shared/driver-bun.ts servers/shared/rules.ts servers/shared/store-sqlite.ts ./
RUN cat driver-bun.ts rules.ts store-sqlite.ts > store.ts && rm driver-bun.ts rules.ts store-sqlite.ts
ENV NODE_ENV=production
CMD ["bun", "main.ts"]
