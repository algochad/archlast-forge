# The same with the items in SQLite through bun:sqlite (build context: benchmarks/rest).
ARG ENGINE_IMAGE=ghcr.io/algochad/archlast-forge-engine:0.17.0
FROM alpine:3.22 AS store
COPY servers/shared/driver-bun.ts servers/shared/rules.ts servers/shared/store-sqlite.ts /s/
RUN cat /s/driver-bun.ts /s/rules.ts /s/store-sqlite.ts > /store.ts

FROM ${ENGINE_IMAGE}
USER root
WORKDIR /app
COPY servers/nest/package.json .
RUN bun install --production
COPY servers/nest/items.controller.ts servers/nest/tsconfig.json ./
COPY servers/nest-serve/adapter.ts servers/nest-serve/main.ts ./
COPY --from=store /store.ts ./store.ts
USER bun
ENV NODE_ENV=production
ENTRYPOINT ["bun"]
CMD ["/app/main.ts"]
