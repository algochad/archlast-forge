{
  "name": "@archlast-forge/framework",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.tsx",
    "./server": "./src/server.tsx",
    "./build": "./src/build.ts"
  },
  "scripts": {
    "typecheck": "bun check",
    "test": "bun test",
    "build": "rm -rf dist && bun build ./src/index.ts ./src/client.tsx ./src/server.tsx ./src/build.ts --root ./src --outdir ./dist --target bun --splitting --packages external && tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@archlast-forge/client": "workspace:*",
    "@archlast-forge/react": "workspace:*",
    "@archlast-forge/runtime": "workspace:*",
    "@tanstack/react-query": "5.104.5",
    "react-router": "8.5.0"
  },
  "peerDependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/bun": "1.4.3",
    "@types/react": "19",
    "@types/react-dom": "19",
    "playwright-core": "^1.64.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}
