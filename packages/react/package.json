{
  "name": "@archlast/forge-react",
  "version": "0.16.0",
  "description": "React hooks for archlast-forge: live queries, mutations, auth.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/algochad/archlast-forge.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/algochad/archlast-forge#readme",
  "bugs": "https://github.com/algochad/archlast-forge/issues",
  "keywords": [
    "archlast-forge",
    "backend",
    "realtime",
    "bun",
    "convex"
  ],
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "bun check",
    "build": "rm -rf dist && bun build ./src/index.ts --outdir ./dist --target browser --packages external && tsc -p tsconfig.build.json"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "@types/react": "19",
    "expect-type": "1"
  },
  "dependencies": {
    "@archlast/forge-client": "workspace:*",
    "@archlast/forge-runtime": "workspace:*",
    "@tanstack/react-query": "5.104.5"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  }
}
