{
  "name": "@archlast/forge-client",
  "version": "0.9.0",
  "description": "Framework-agnostic client for archlast-forge: calls and live queries over HTTP and WebSocket.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/algochad/archlast-forge.git",
    "directory": "packages/client"
  },
  "homepage": "https://github.com/algochad/archlast-forge#readme",
  "bugs": "https://github.com/algochad/archlast-forge/issues",
  "keywords": [
    "archlast-forge",
    "backend",
    "realtime",
    "bun",
    "convex"
  ],
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "bun check",
    "test": "bun test",
    "build": "rm -rf dist && bun build ./src/index.ts --outdir ./dist --target browser --packages external && tsc -p tsconfig.build.json"
  },
  "devDependencies": {
    "@types/bun": "1.4.4"
  },
  "dependencies": {
    "@archlast/forge-runtime": "workspace:*",
    "@tanstack/query-core": "5.104.5",
    "better-auth": "1.7.12"
  }
}
