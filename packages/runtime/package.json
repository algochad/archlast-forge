{
  "name": "@archlast-forge/runtime",
  "version": "0.1.0",
  "description": "The archlast-forge engine: schema, functions, the reactive server, and the testing library.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/algochad/archlast-forge.git",
    "directory": "packages/runtime"
  },
  "homepage": "https://github.com/algochad/archlast-forge#readme",
  "bugs": "https://github.com/algochad/archlast-forge/issues",
  "keywords": [
    "archlast-forge",
    "backend",
    "realtime",
    "bun",
    "convex"
  ],
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./server": "./src/server/index.ts",
    "./testing": "./src/testing.ts"
  },
  "scripts": {
    "typecheck": "bun check && bun check -p test-types",
    "test": "bun test",
    "build": "rm -rf dist && bun build ./src/index.ts ./src/server/index.ts ./src/server/child.ts ./src/testing.ts --root ./src --outdir ./dist --target bun --packages external && tsc -p tsconfig.build.json"
  },
  "devDependencies": {
    "@types/bun": "1.4.3",
    "expect-type": "^1.4.0"
  },
  "dependencies": {
    "better-auth": "1.7.12",
    "zod": "4.6.7"
  },
  "engines": {
    "bun": ">=1.4.3"
  }
}
