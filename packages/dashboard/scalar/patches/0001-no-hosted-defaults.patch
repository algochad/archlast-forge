Subject: [PATCH 1/2] No hosted defaults: no default proxy, no scalar.com example URLs

Why: the request builder runs on an app's own docs page, for that app's visitors. Two defaults point at Scalar's hosted services:

  - getDefaultProxyUrl() answers "https://proxy.scalar.com" for the "web" layout. The builder never uses that layout (it is the
    modal), but the default would route a visitor's requests, with their credentials, through a third party the moment anything
    did. The default is now "no proxy" in every layout; a proxy is used only when the app configures one.
  - The OAuth2 form's placeholders (and the refresh URL hint) suggest galaxy.scalar.com, a demo server of the vendor. They now
    show example.com.

Touches: packages/workspace-store, packages/api-client. Small and unlikely to conflict; if upstream renames these, redo it by hand.

---
diff --git a/packages/api-client/src/v2/blocks/scalar-auth-selector-block/components/OAuth2.vue b/packages/api-client/src/v2/blocks/scalar-auth-selector-block/components/OAuth2.vue
index f707492..64876ba 100644
--- a/packages/api-client/src/v2/blocks/scalar-auth-selector-block/components/OAuth2.vue
+++ b/packages/api-client/src/v2/blocks/scalar-auth-selector-block/components/OAuth2.vue
@@ -390,7 +390,7 @@ const refreshUrlPlaceholder = computed(() => {
   if ('tokenUrl' in flow.value && flow.value.tokenUrl) {
     return flow.value.tokenUrl
   }
-  return 'https://galaxy.scalar.com/oauth/refresh'
+  return 'https://example.com/oauth/token'
 })
 
 /**
@@ -566,7 +566,7 @@ const handleSecretLocationUpdate = (value: string): void => {
         containerClass="border-r-0"
         :environment
         :modelValue="flow['x-scalar-secret-auth-url'] ?? ''"
-        placeholder="https://galaxy.scalar.com/authorize"
+        placeholder="https://example.com/oauth/authorize"
         @reset="handleResetSecret('x-scalar-secret-auth-url')"
         @update:modelValue="
           (v) => {
@@ -587,7 +587,7 @@ const handleSecretLocationUpdate = (value: string): void => {
         "
         :environment
         :modelValue="flow['x-scalar-secret-token-url'] ?? ''"
-        placeholder="https://galaxy.scalar.com/token"
+        placeholder="https://example.com/oauth/token"
         @reset="handleResetSecret('x-scalar-secret-token-url')"
         @update:modelValue="
           (v) => {
diff --git a/packages/workspace-store/src/request-example/context/proxy.ts b/packages/workspace-store/src/request-example/context/proxy.ts
index 28e787e..f1908a1 100644
--- a/packages/workspace-store/src/request-example/context/proxy.ts
+++ b/packages/workspace-store/src/request-example/context/proxy.ts
@@ -3,15 +3,11 @@ import type { Workspace } from '@/schemas/workspace'
 export type Layout = 'web' | 'other'
 
 /**
- * Returns the default proxy URL for web layout.
- * For the 'web' layout, this ensures requests use Scalar's hosted proxy unless overridden,
- * which is important for browser environments with CORS or network restrictions.
- * For 'desktop' or 'modal' layouts, returns null to indicate no proxy by default.
+ * Returns the default proxy URL: none, in every layout. Upstream's web layout defaults to Scalar's hosted proxy
+ * (proxy.scalar.com), which would send the visitor's requests, with their credentials, through a third party. A proxy is
+ * only ever used when the app sets one.
  */
-export const getDefaultProxyUrl = (layout: Layout) => {
-  if (layout === 'web') {
-    return 'https://proxy.scalar.com'
-  }
+export const getDefaultProxyUrl = (_layout: Layout) => {
   return null
 }
 
